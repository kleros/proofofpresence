{
  "name": "kleros-event-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "compile": "node references/kickback/scripts/compile.mjs",
    "build": "npm run compile && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "node src/server.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:contracts": "npm --prefix references/kickback test",
    "test:browser": "node test/app.e2e.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run test:browser && npm run test:ui && npm run test:ui:safety && npm run test:ui:context",
    "test:ui": "node test/ui-redesign.e2e.mjs",
    "test:ui:safety": "node test/ui-safety.e2e.mjs",
    "test:ui:context": "node test/ui-context.e2e.mjs"
  },
  "dependencies": {
    "csv-parse": "5.6.0",
    "ethers": "6.16.0",
    "ganache": "7.9.2",
    "solc": "0.8.28"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.15.30",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
