{
  "name": "truth-pays-kickback",
  "version": "2.0.0",
  "description": "Kickback-style refundable ETH deposits on Ethereum mainnet for Luma events, with Kleros attendance challenges",
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=600000 test/contract.test.mjs test/kickback.test.mjs test/provenance.test.mjs",
    "verify": "node scripts/verify-deposits.mjs",
    "payout": "node scripts/build-payout.mjs",
    "deploy": "node scripts/deploy.mjs",
    "owner": "node scripts/owner.mjs",
    "console": "node scripts/console.mjs",
    "console:rehearsal": "node scripts/console.mjs --config config.rehearsal.json --out out-rehearsal",
    "site": "node scripts/build-site.mjs",
    "test:site": "node test/site.e2e.mjs",
    "test:console": "node test/console.e2e.mjs",
    "test:fork": "node test/fork.e2e.mjs",
    "test:provenance": "node --test test/provenance.test.mjs",
    "review:import": "node scripts/review-import.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "csv-parse": "^5.5.6",
    "ethers": "^6.13.4",
    "solc": "0.8.28"
  },
  "devDependencies": {
    "ganache": "^7.9.2",
    "playwright": "1.56.1"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
