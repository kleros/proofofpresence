# Default local synthetic demo. No real financial providers are connected.
PORT=3000
RPC_PORT=18545
# Explicit new-contract sandbox; historical v7 remains the default.
# CONTRACT_VERSION=kleros-event-v8

# External Chiado: wallet-only signing; no impersonation or time controls.
# MODE=testnet
# TESTNET_MANIFEST=/absolute/path/to/registry/chiado-v8-controlled.json
# TESTNET_STATE_FILE=/absolute/path/to/private/workbench-state.json
# Hosted testnet also uses HTTPS origins/proxy key below and a persistent /data volume.
# MODE=hosted-testnet

# Hosted demo requires explicit HTTPS origins and a server-only generated key.
# Configure with scripts/configure-hosted-deployment.py; never commit real values.
# MODE=hosted-demo
# PUBLIC_ORIGIN=https://YOUR_NETLIFY_SITE.netlify.app
# BACKEND_ORIGIN=https://YOUR_BACKEND.up.railway.app
# PROXY_SECRET=GENERATE_A_HIGH_ENTROPY_URL_SAFE_VALUE
# RPC_PORT=0
# RUNTIME_ROOT=/app/.runtime
