# Set these on the new Netlify project for Production, with Functions access.
# This example is documentation only; Netlify does not import it automatically.
KLEROS_BACKEND_URL=https://luma-v10-mainnet-backend-production.up.railway.app
KLEROS_PUBLIC_ORIGIN=https://kickback.kleros.io
# Obtain the matching existing Railway PROXY_SECRET through a private channel.
# Replace this placeholder in Netlify settings; never commit the real value.
KLEROS_PROXY_SECRET=<SHARED_PROXY_SECRET_PROVIDED_PRIVATELY>
